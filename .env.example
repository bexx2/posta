# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=https://posta.example.com

DB_NAME=posta
DB_USER=posta
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# dryrun = no real mail server needed (development). mailcow = real mailboxes.
MAIL_BACKEND=dryrun
MAILCOW_API_URL=https://mail.example.com/api/v1
MAILCOW_API_KEY=

# What customers put in their DNS
MX_TARGET=mail.example.com
SPF_INCLUDE=spf.example.com
SPF_INCLUDE_IP=203.0.113.10

# Outgoing mail for sign-up and password reset
EMAIL_HOST=127.0.0.1
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=posta <noreply@example.com>
